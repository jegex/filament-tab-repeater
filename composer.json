{
	"name": "jegex/filament-tab-repeater",
	"description": "Filament Repeater field that renders each item as a tab.",
	"type": "library",
	"version": "2.0.0",
	"license": "MIT",
	"keywords": [
		"filament",
		"forms",
		"repeater",
		"tabs"
	],
	"require": {
		"php": "^8.3",
		"filament/forms": "^5.9",
		"illuminate/support": "^13.0",
		"spatie/laravel-package-tools": "^1.93"
	},
	"require-dev": {
		"laravel/pint": "^1.27",
		"livewire/livewire": "^4.4",
		"orchestra/testbench": "^11.3",
		"pestphp/pest": "^5.3",
		"pestphp/pest-plugin-laravel": "^5.0"
	},
	"autoload": {
		"psr-4": {
			"Jegex\\FilamentTabRepeater\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Jegex\\FilamentTabRepeater\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "pest",
		"lint": "pint --test"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"laravel": {
			"providers": [
				"Jegex\\FilamentTabRepeater\\FilamentTabRepeaterServiceProvider"
			]
		}
	}
}
